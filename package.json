{
  "name": "restoran-app",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "// posUrl": "Site the desktop app opens. Currently the development deploy — testing kitchen printing against a live restaurant is not an option. Change to https://www.possiblle.com when it ships.",
  "posUrl": "https://restoran-app-git-development-p-f968e3-kamrans-projects-11d6b816.vercel.app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "agent": "tsx --env-file=agent/.env agent/index.ts",
    "desktop:compile": "tsc -p electron/tsconfig.json",
    "desktop": "npm run desktop:compile && node scripts/run-electron.mjs",
    "desktop:preview": "npm run desktop:compile && node scripts/run-electron.mjs --url=https://restoran-app-git-development-p-f968e3-kamrans-projects-11d6b816.vercel.app",
    "desktop:dist": "npm run desktop:compile && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.possiblle.pos",
    "productName": "Possiblle POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PossibllePOS-Setup-${version}.exe"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.108.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "qz-tray": "^2.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.2.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qz-tray": "^2.2.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-push": "^3.6.4",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
