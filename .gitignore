# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude settings (may contain secrets)
.claude/

# print agent secrets (service-role key)
agent/.env

# supabase CLI scratch (version cache, linked-project state)
supabase/.temp/

# Electron build output
dist-electron/
release/

# Desktop till: the staging copy of the repo and the static export it produces.
# Both are build artefacts of scripts/build-desktop.mjs and are rebuilt from
# source every time; committing either would also commit a bundle with a
# Supabase project baked into it.
.desktop-build/
out-desktop/
