{
  // The desktop shell is a Node program, not part of the Next bundle: CommonJS,
  // no DOM, and emitted to dist-electron/ for electron-builder to package.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "..",
    "outDir": "../dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../lib/tcp-print.ts"]
}
